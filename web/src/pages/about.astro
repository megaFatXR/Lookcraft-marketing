---
// Why Lookeo exists, where it's going and who makes it, in the founder's words. No names on
// purpose. When someone joins, add them to the team list below.
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { BRAND_NAME, CITY, CONTACT_EMAIL } from '../consts';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const team = [
	{ role: 'Founder · Engineer', about: 'Builds the app, the stylist and everything behind them.' },
	// { role: 'Style · Co-founder', about: 'Architect and fashion creator. Shapes how the stylist dresses people.' },
];
---

<Base
	title={`About — ${BRAND_NAME}`}
	description={`Why ${BRAND_NAME} exists: a small project from ${CITY} to build a real personal stylist that understands your taste and dresses you for every occasion.`}
>
	<PageHeader />

	<main class="container page">
		<p class="eyebrow">About</p>
		<h1>A small project from {CITY}.</h1>

		<div class="story">
			<p class="lede">
				I love clothes and dressing well. I’m picky about what I wear, and I even like a good
				accessory or two. But I’ve always been terrible at shopping.
			</p>
			<p>
				I’d see something I loved, on someone in the street or in a photo online, and have no idea
				where to find it, or what to wear it with.
			</p>
			<p>
				{BRAND_NAME} was born from that. Tell it what you need, or show it a look you love, and it
				puts together whole looks from real pieces sold in your country, within your budget, with
				the shop and price for each one. Then you can try a look on a photo of yourself before you
				buy anything.
			</p>
		</div>

		<section class="mission" aria-labelledby="mission-title">
			<p class="label" id="mission-title">Where we’re going</p>
			<p class="statement">
				{BRAND_NAME} should become a real personal stylist: one that understands your taste and puts
				together the perfect look for every occasion in your life.
			</p>
			<p class="note">
				We’re passionate about this project, and we want to see it become everything we imagine.
				This is only the beginning.
			</p>
		</section>

		<h2>Who we are</h2>
		<p>
			A small, independent team in {CITY}. Your photos stay on your phone: they’re only sent to
			make a try-on, and we don’t keep them. The prices you see are the ones the shops list.
		</p>
		<ul class="team">
			{
				team.map((person) => (
					<li class="card">
						<span class="role">{person.role}</span>
						<span class="bio">{person.about}</span>
					</li>
				))
			}
		</ul>

		<h2>Say hello</h2>
		<p>
			Ideas, feedback or a look that came out wrong? Write to <a href={`mailto:${CONTACT_EMAIL}`}
				>{CONTACT_EMAIL}</a
			>. Writing about {BRAND_NAME}? Our <a href={withBase('press/')}>press kit</a> has logos,
			screenshots and the facts.
		</p>
	</main>

	<Footer />
</Base>

<style>
	.page {
		max-width: 46rem;
		padding-block: clamp(1.5rem, 6vw, 3rem) clamp(3rem, 8vw, 5rem);
	}

	.eyebrow {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--coral);
	}

	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2.5rem, 8vw, 3.5rem);
	}

	.story {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 1.0625rem;
	}

	.story .lede {
		color: var(--text);
		font-size: 1.25rem;
	}

	.mission {
		margin-top: clamp(2.5rem, 8vw, 3.5rem);
		padding: clamp(1.5rem, 5vw, 2.25rem);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.label {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--coral);
	}

	.statement {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4.5vw, 2rem);
		line-height: 1.2;
		text-wrap: balance;
	}

	.mission .note {
		margin-top: 1rem;
		color: var(--muted);
	}

	h2 {
		margin-top: clamp(2.5rem, 8vw, 3.5rem);
		font-size: clamp(1.75rem, 5vw, 2.25rem);
	}

	h2 + p {
		margin-top: 1rem;
	}

	.team {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
		padding: 0;
		list-style: none;
	}

	.card {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.role {
		font-family: var(--font-display);
		font-size: 1.375rem;
	}

	.bio {
		color: var(--muted);
	}

	a {
		text-underline-offset: 0.2em;
	}
</style>
