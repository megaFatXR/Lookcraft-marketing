---
// Who makes Lookeo, in a few honest lines. The team list grows when someone joins: add an
// entry with their name, role and a line about them.
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { BRAND_NAME, CITY, CONTACT_EMAIL, FOUNDER_NAME } from '../consts';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const team = [
	{
		name: FOUNDER_NAME,
		role: 'Founder · Engineer',
		about: `Builds the app, the stylist and everything behind them.`,
	},
	// {
	// 	name: '…',
	// 	role: 'Style · Co-founder',
	// 	about: 'Architect and fashion creator. Shapes how the stylist dresses people.',
	// },
];
---

<Base
	title={`About — ${BRAND_NAME}`}
	description={`${BRAND_NAME} is a small, independent project from ${CITY}: a stylist that builds whole looks from real pieces in your budget, and lets you try them on first.`}
>
	<PageHeader />

	<main class="container page">
		<p class="eyebrow">About</p>
		<h1>A small project from {CITY}.</h1>
		<p class="lede">
			{BRAND_NAME} started with a simple problem: buying clothes one piece at a time, and ending up
			with things that don’t go together.
		</p>

		<div class="story">
			<p>
				A good stylist thinks in whole looks. They know what suits you, what fits your budget and
				where to find it. Most people never get one. So we built one into an app.
			</p>
			<p>
				Tell {BRAND_NAME} what you need in a few words, or show it a look you love. It puts
				together complete looks from real pieces sold in your country, within the budget you set,
				with the shop and price for each one. Then you can try a look on a photo of yourself
				before you buy anything.
			</p>
			<p>
				We’re independent and small on purpose. Your photos stay on your phone: they’re only sent
				to make a try-on, and we don’t keep them. The prices you see are the ones the shops list.
			</p>
		</div>

		<h2>Who we are</h2>
		<ul class="team">
			{
				team.map((person) => (
					<li class="card">
						<span class="name">{person.name ? person.name : <mark>[your name]</mark>}</span>
						<span class="role">{person.role}</span>
						<span class="bio">{person.about}</span>
					</li>
				))
			}
		</ul>

		<h2>Say hello</h2>
		<p>
			Ideas, feedback or a look that came out wrong? Write to <a href={`mailto:${CONTACT_EMAIL}`}
				>{CONTACT_EMAIL}</a
			>. Writing about {BRAND_NAME}? Our <a href={withBase('press/')}>press kit</a> has logos,
			screenshots and the facts.
		</p>
	</main>

	<Footer />
</Base>

<style>
	.page {
		max-width: 46rem;
		padding-block: clamp(1.5rem, 6vw, 3rem) clamp(3rem, 8vw, 5rem);
	}

	.eyebrow {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--coral);
	}

	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2.5rem, 8vw, 3.5rem);
	}

	.lede {
		margin-top: 1rem;
		font-size: 1.25rem;
	}

	.story {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 1.0625rem;
	}

	h2 {
		margin-top: clamp(2.5rem, 8vw, 3.5rem);
		font-size: clamp(1.75rem, 5vw, 2.25rem);
	}

	h2 + p {
		margin-top: 1rem;
	}

	.team {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
		padding: 0;
		list-style: none;
	}

	.card {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.name {
		font-family: var(--font-display);
		font-size: 1.5rem;
	}

	.role {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--coral);
	}

	.bio {
		margin-top: 0.5rem;
		color: var(--muted);
	}

	a {
		text-underline-offset: 0.2em;
	}
</style>
