---
// Everything a writer needs on one page: the facts, ready-to-use descriptions, logos and
// screenshots. The files live in public/press/; lookeo-press-kit.zip holds all of them but
// the small previews in thumbs/. Rebuild the zip when a file changes.
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { APP_RELEASED, APP_STORE_URL, BRAND_NAME, CITY, CONTACT_EMAIL } from '../consts';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const file = (name: string) => withBase(`press/${name}`);

const facts = [
	['Name', `${BRAND_NAME}: Stylist & Try On`],
	['What it is', 'A personal stylist app: whole looks from real pieces in your budget, tried on a photo of you'],
	['Made in', `${CITY}, Spain, by a small independent team`],
	['Platforms', 'iPhone (iOS 26 and later). Android coming soon'],
	['Availability', APP_RELEASED ? 'App Store' : 'Coming soon to the App Store'],
	['Countries', 'Spain, United States, United Kingdom, France, Italy and Germany'],
	['Languages', 'English, Spanish, French and Italian'],
	['Price', 'Free to download, with 3 free try-ons. More try-ons come in packs'],
	['Website', 'lookeo.app'],
	['Press contact', CONTACT_EMAIL],
];

const short = `${BRAND_NAME} is a personal stylist in your pocket: it builds complete looks from real pieces you can buy, within your budget, and lets you try them on a photo of yourself before you buy.`;
const long = `Tell ${BRAND_NAME} what you need in a few words, answer three quick questions, or show it a screenshot of a look you love. Its stylist puts together complete looks from real pieces sold in your country, from shops like Zara, Mango or Camper, within the budget you set, with the shop and price of every piece. Then you can try any look on a photo of yourself, and see it on you before you spend anything. Made by a small team in ${CITY}.`;

const logos = [
	{ name: 'App icon', file: 'lookeo-app-icon.png', note: 'PNG · 1024 × 1024', bg: 'light' },
	{ name: 'Wordmark, charcoal', file: 'lookeo-wordmark-charcoal.png', note: 'PNG · transparent', bg: 'light' },
	{ name: 'Wordmark, cream', file: 'lookeo-wordmark-cream.png', note: 'PNG · transparent', bg: 'dark' },
	{ name: 'Mark, charcoal', file: 'lookeo-mark-charcoal.svg', note: 'SVG', bg: 'light' },
	{ name: 'Mark, cream', file: 'lookeo-mark-cream.svg', note: 'SVG', bg: 'dark' },
	{ name: 'Avatar', file: 'lookeo-avatar-cream.png', note: 'PNG · 1080 × 1080', bg: 'light' },
];

const screenshots = [
	['1-before-after.jpg', 'Before and after a try-on'],
	['2-brief.jpg', 'Briefing the stylist'],
	['3-shops.jpg', 'Real pieces from real shops'],
	['4-budget.jpg', 'Looks within your budget'],
	['5-looks.jpg', 'Your looks'],
	['6-styles.jpg', 'Every style'],
];
---

<Base
	title={`Press kit — ${BRAND_NAME}`}
	description={`Logos, screenshots, descriptions and facts about ${BRAND_NAME}, the stylist app that builds looks from real pieces and lets you try them on.`}
>
	<PageHeader />

	<main class="container page">
		<p class="eyebrow">Press kit</p>
		<h1>Writing about {BRAND_NAME}?</h1>
		<p class="lede">
			Everything you need is here: the facts, descriptions you can use as they are, logos and
			screenshots. For anything else, interviews or early access, email <a
				href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
			>.
		</p>
		<a class="download" href={file('lookeo-press-kit.zip')} download>
			Download the press kit <span>ZIP · 3 MB</span>
		</a>

		<h2>The facts</h2>
		<dl class="facts">
			{
				facts.map(([term, value]) => (
					<div>
						<dt>{term}</dt>
						<dd>
							{term === 'Availability' && APP_RELEASED ? <a href={APP_STORE_URL}>{value}</a> : value}
						</dd>
					</div>
				))
			}
		</dl>

		<h2>Descriptions</h2>
		<div class="copy">
			<p class="label">One line</p>
			<blockquote>{short}</blockquote>
			<p class="label">A paragraph</p>
			<blockquote>{long}</blockquote>
		</div>

		<h2>Logos</h2>
		<ul class="grid logos">
			{
				logos.map((logo) => (
					<li>
						<a class="tile" href={file(logo.file)} download>
							<span class:list={['preview', logo.bg]}>
								<img src={file(logo.file)} alt="" loading="lazy" />
							</span>
							<span class="name">{logo.name}</span>
							<span class="note">{logo.note}</span>
						</a>
					</li>
				))
			}
		</ul>

		<h2>Screenshots</h2>
		<ul class="grid shots">
			{
				screenshots.map(([name, caption]) => (
					<li>
						<a class="tile" href={file(`screenshots/${name}`)} download>
							<img src={file(`thumbs/${name}`)} alt={caption} loading="lazy" width="320" height="695" />
							<span class="name">{caption}</span>
							<span class="note">JPG · 1320 × 2868</span>
						</a>
					</li>
				))
			}
		</ul>

		<h2>Who’s behind it</h2>
		<p>
			{BRAND_NAME} is made by a small, independent team in {CITY}. More on our <a
				href={withBase('about/')}>About page</a
			>.
		</p>
	</main>

	<Footer />
</Base>

<style>
	.page {
		max-width: 56rem;
		padding-block: clamp(1.5rem, 6vw, 3rem) clamp(3rem, 8vw, 5rem);
	}

	.eyebrow {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--coral);
	}

	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2.5rem, 8vw, 3.5rem);
	}

	.lede {
		margin-top: 1rem;
		max-width: 40rem;
		font-size: 1.125rem;
		color: var(--muted);
	}

	a {
		text-underline-offset: 0.2em;
	}

	.download {
		display: inline-flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-top: 1.5rem;
		padding: 0.875rem 1.5rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-text);
		font-weight: 600;
		text-decoration: none;
	}

	.download span {
		font-size: 0.875rem;
		font-weight: 500;
		opacity: 0.7;
	}

	h2 {
		margin-top: clamp(2.5rem, 8vw, 3.5rem);
		font-size: clamp(1.75rem, 5vw, 2.25rem);
	}

	h2 + p {
		margin-top: 1rem;
	}

	.facts {
		margin-top: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.facts div {
		display: grid;
		grid-template-columns: minmax(7rem, 11rem) 1fr;
		gap: 1rem;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--line);
	}

	dt {
		color: var(--muted);
	}

	dd {
		margin: 0;
	}

	.copy {
		margin-top: 1.25rem;
	}

	.label {
		margin-top: 1.25rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--muted);
	}

	.label:first-child {
		margin-top: 0;
	}

	blockquote {
		margin: 0.5rem 0 0;
		padding: 1rem 1.25rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		user-select: all;
	}

	.grid {
		display: grid;
		gap: 1rem;
		margin-top: 1.25rem;
		padding: 0;
		list-style: none;
	}

	.logos {
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
	}

	.shots {
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.tile {
		display: grid;
		gap: 0.25rem;
		text-decoration: none;
	}

	.tile:hover .name {
		text-decoration: underline;
	}

	.preview {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		margin-bottom: 0.5rem;
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.preview.light {
		background: #f4efe9;
	}

	.preview.dark {
		background: #212121;
	}

	.preview {
		overflow: hidden;
	}

	.preview img {
		width: 100%;
		height: 6.5rem;
		object-fit: contain;
	}

	.shots img {
		width: 100%;
		height: auto;
		margin-bottom: 0.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.name {
		font-weight: 600;
	}

	.note {
		font-size: 0.875rem;
		color: var(--muted);
	}

	@media (max-width: 30rem) {
		.facts div {
			grid-template-columns: 1fr;
			gap: 0.125rem;
		}
	}
</style>
