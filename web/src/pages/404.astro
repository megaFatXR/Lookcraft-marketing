---
// GitHub Pages serves this for any address that doesn't exist.
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { BRAND_NAME } from '../consts';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title={`Page not found — ${BRAND_NAME}`} description="This page doesn’t exist." noindex>
	<PageHeader />

	<main class="container page">
		<h1>This page isn’t in the collection</h1>
		<p>The link may be old, or the address has a typo.</p>
		<nav aria-label="Where to go">
			<a class="primary" href={withBase('')}>Go to the home page</a>
			<a href={withBase('support/')}>Support</a>
		</nav>
	</main>

	<Footer />
</Base>

<style>
	.page {
		max-width: 46rem;
		display: grid;
		justify-items: start;
		gap: 1rem;
		padding-block: clamp(3rem, 12vw, 7rem);
	}

	h1 {
		font-size: clamp(2.25rem, 7vw, 3.25rem);
		max-width: 16ch;
	}

	p {
		font-size: 1.125rem;
		color: var(--muted);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1rem;
	}

	a {
		font-weight: 600;
		text-underline-offset: 0.2em;
	}

	.primary {
		padding: 0.875rem 1.5rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-text);
		text-decoration: none;
	}

	.primary:hover {
		opacity: 0.9;
	}

	a:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 3px;
	}
</style>
