---
// An iPhone frame for one app screen. Drop a screenshot into src/assets/screens/
// named after the slot (hero.png, step-brief.png…; png, jpg or webp) and it
// replaces the placeholder at the next build. No code change needed. See
// src/assets/screens/README.md for the list of slots and screens.
import { Image } from 'astro:assets';
import Mark from '../assets/mark.svg';

interface Props {
	/** The file name without its extension, in src/assets/screens/. */
	name: string;
	/** What the screenshot shows, for screen readers, once there is one. */
	alt: string;
	/** Loaded right away when it's in the first screen of the page. */
	eager?: boolean;
	class?: string;
}

const { name, alt, eager = false, class: className } = Astro.props;

const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.{png,jpg,jpeg,webp}', {
	eager: true,
});
const screen = Object.entries(screens).find(([path]) => path.replace(/^.*\//, '').replace(/\.\w+$/, '') === name)?.[1]
	.default;
---

<figure class:list={['phone', className]} data-slot={name}>
	<div class="screen">
		{
			screen ? (
				<Image
					src={screen}
					alt={alt}
					widths={[320, 480, 720]}
					sizes="(min-width: 56rem) 18rem, 60vw"
					loading={eager ? 'eager' : 'lazy'}
				/>
			) : (
				<div class="placeholder" aria-hidden="true">
					<Mark />
				</div>
			)
		}
		<span class="island" aria-hidden="true"></span>
	</div>
</figure>

<style>
	/* Sized from the width; the height follows an iPhone screenshot (1320×2868). */
	.phone {
		margin: 0;
		width: 100%;
		max-width: 18rem;
		padding: 0.5rem;
		border-radius: 3rem;
		background: #111;
		box-shadow:
			0 0 0 1px #2a2a2a inset,
			0 1.5rem 3rem -1.25rem rgb(33 33 33 / 0.35);
	}

	.screen {
		position: relative;
		aspect-ratio: 1320 / 2868;
		overflow: hidden;
		border-radius: 2.5rem;
		background: var(--placeholder);
	}

	.screen :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		color: var(--text);
		background: radial-gradient(120% 70% at 50% 35%, var(--bg), var(--placeholder));
	}

	.placeholder :global(svg) {
		width: 28%;
		height: auto;
		opacity: 0.85;
	}

	/* The Dynamic Island, over the screenshot's status bar. */
	.island {
		position: absolute;
		top: 2.4%;
		left: 50%;
		width: 32%;
		aspect-ratio: 3.4;
		translate: -50% 0;
		border-radius: 999px;
		background: #111;
	}

	@media (prefers-color-scheme: dark) {
		.phone {
			box-shadow:
				0 0 0 1px #3b3733,
				0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.6);
		}
	}
</style>
