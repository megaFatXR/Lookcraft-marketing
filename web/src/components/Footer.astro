---
import { BRAND_NAME, CONTACT_EMAIL, INSTAGRAM_URL, TIKTOK_URL } from '../consts';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="container">
	<div class="brand">
		<p>© {year} {BRAND_NAME}</p>
		<div class="social">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label={`${BRAND_NAME} on Instagram`}>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
					<rect x="3" y="3" width="18" height="18" rx="5" />
					<circle cx="12" cy="12" r="4.2" />
					<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
				</svg>
			</a>
			<a href={TIKTOK_URL} target="_blank" rel="noopener" aria-label={`${BRAND_NAME} on TikTok`}>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
					<path d="M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.3 6.3 0 1 0 5.3 6.2V8.6a7.7 7.7 0 0 0 4.4 1.4V6.7a4.4 4.4 0 0 1-4.4-4.4Z" />
				</svg>
			</a>
		</div>
	</div>
	<nav aria-label="Site">
		<a href={withBase('support/')}>Support</a>
		<a href={withBase('privacy/')}>Privacy Policy</a>
		<a href={withBase('terms/')}>Terms of Use</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</nav>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem 1.5rem;
		padding-block: 2rem 3rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.social {
		display: flex;
		gap: 0.25rem;
	}

	.social a {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
	}

	.social a:hover {
		background: var(--line);
	}

	.social svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}

	a {
		text-underline-offset: 0.2em;
	}

	a:hover {
		color: var(--text);
	}
</style>
