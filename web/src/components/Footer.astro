---
import { CONTACT_EMAIL } from '../consts';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="container">
	<p>© {year} Lookcraft · <a href={withBase('privacy/')}>Privacy Policy</a> · <a href={withBase('terms/')}>Terms of Use</a> · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 2rem 3rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}

	a {
		text-underline-offset: 0.2em;
	}

	a:hover {
		color: var(--text);
	}
</style>
