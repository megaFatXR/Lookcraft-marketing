---
const points = [
	{
		title: 'Whole looks, not single items',
		body: 'The stylist plans every piece together, from the top to the shoes, and you try the whole look on at once.',
	},
	{
		title: 'Real shops in your country',
		body: 'Every piece is a product you can buy now from a shop that sells where you live, in your currency. Second-hand listings are left out.',
	},
	{
		title: 'Your budget',
		body: 'Pick what a look may cost, and the stylist plans the pieces around it, from high-street brands to premium ones when you allow more.',
	},
	{
		title: 'Free to style',
		body: 'Briefs, concepts and crafting looks are always free. You only pay for try-ons, and you start with 3 on us.',
	},
];
---

<section class="different" aria-labelledby="different-title">
	<div class="container">
		<h2 id="different-title">What makes it different</h2>
		<ul>
			{
				points.map(({ title, body }) => (
					<li class="card">
						<h3>{title}</h3>
						<p>{body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.different {
		padding-block: clamp(3rem, 8vw, 5rem);
		border-top: 1px solid var(--line);
	}

	h2 {
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		margin-bottom: 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	}

	/* Rounded, outlined cards, as in the app. */
	.card {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	h3 {
		font-size: 1.375rem;
	}

	p {
		color: var(--muted);
	}
</style>
