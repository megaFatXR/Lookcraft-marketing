---
import Mark from '../assets/mark.svg';
import { withBase } from '../lib/url';
---

<a class="logo" href={withBase('')} aria-label="Lookcraft home">
	<Mark aria-hidden="true" />
	<span>Lookcraft</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.logo :global(svg) {
		display: block;
		width: auto;
		height: 2.25rem;
	}
</style>
