---
import Mark from '../assets/mark.svg';
import { BRAND_NAME } from '../consts';
import { withBase } from '../lib/url';
---

<a class="logo" href={withBase('')} aria-label={`${BRAND_NAME} home`}>
	<Mark aria-hidden="true" />
	<span>{BRAND_NAME}</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.logo :global(svg) {
		display: block;
		width: auto;
		height: 2.25rem;
	}

	.logo :global(svg path:last-child) {
		fill: var(--coral);
	}

	.logo:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 4px;
		border-radius: var(--radius-small);
	}
</style>
