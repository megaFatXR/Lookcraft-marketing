---
// Step 2 of How it works: the phone shows the top of a real concept ("Navy City Look",
// src/assets/screens/step-concept.png), and a larger card overlapping the phone's edge
// shows two of its product rows up close, drawn like the app's PieceRow
// (StyleFit/Looks/PieceRow.swift in the app repo): the piece, its budget, then cards with
// AI pick on the stylist's choice, a check on the picked product, brand · shop and price.
//
// Each row slides slowly sideways in a seamless loop (the cards twice over, moved by half),
// at slightly different speeds, as if someone were browsing. Pure CSS; a small script only
// pauses it off screen and draws the two "zoomed in from here" lines between the outline on
// the phone and the card. Without the script the lines are missing, nothing else. With
// reduced motion the rows stay still on the stylist's picks.
//
// The products, shops, brands and prices are the concept's real ones (Spain, in euros), as
// the app showed them. The photos are the shops' thumbnails, kept in src/assets/concept/.
import { Image } from 'astro:assets';
import PhoneFrame from './PhoneFrame.astro';

type Card = { image: ImageMetadata; shop: string; price: string; aiPick?: boolean; picked?: boolean };
type Row = { piece: string; budget: string; cards: Card[]; seconds: number };

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/concept/*.webp', { eager: true });
const image = (name: string) => images[`../assets/concept/${name}.webp`].default;

const rows: Row[] = [
	{
		piece: 'Top',
		budget: '≤ € 65',
		seconds: 44,
		cards: [
			{ image: image('top-1'), shop: 'Uniqlo Spain', price: '39,90 €', aiPick: true, picked: true },
			{ image: image('top-2'), shop: 'piele multimarca', price: '56,00 €' },
			{ image: image('top-3'), shop: 'ovsfashion.com', price: '49,95 €' },
			{ image: image('top-4'), shop: 'Mi Vestidor Azul', price: '39,95 €' },
			{ image: image('top-5'), shop: 'Uniqlo Spain', price: '49,90 €' },
			{ image: image('top-6'), shop: 'Springfield', price: '29,99 €' },
			{ image: image('top-8'), shop: 'United Colors of Benetton · Zalando.es', price: '69,95 €' },
		],
	},
	{
		piece: 'Bottom',
		budget: '≤ € 50',
		seconds: 52,
		cards: [
			{ image: image('bottom-1'), shop: 'Zalando.es', price: '39,99 €', aiPick: true },
			{ image: image('bottom-2'), shop: 'Levi’s · Amazon.es', price: '53,51 €' },
			{ image: image('bottom-3'), shop: 'MANGO', price: '39,99 €', picked: true },
			{ image: image('bottom-4'), shop: 'Springfield', price: '29,99 €' },
			{ image: image('bottom-5'), shop: 'Levi’s · Lyst.com ES', price: '104,00 €' },
			{ image: image('bottom-6'), shop: 'sötkatt.com', price: '89,00 €' },
			{ image: image('bottom-7'), shop: 'Zaguanshop', price: '69,99 €' },
		],
	},
];
---

<figure class="callout" data-callout>
	<figcaption class="visually-hidden">
		A concept called Navy City Look, with a row of real products for each piece: navy sweaters
		from Uniqlo, OVS, Springfield and Benetton for the top, and jeans from Mango, Levi’s and
		Springfield for the bottom, each with its shop and price, the stylist’s pick marked.
	</figcaption>

	<div class="stage" aria-hidden="true">
		<div class="phone-wrap">
			<PhoneFrame name="step-concept" alt="" />
			<div class="screen-box">
				<span class="zoom" data-zoom></span>
			</div>
		</div>

		<svg class="lines" data-lines>
			<line data-line></line>
			<line data-line></line>
		</svg>

		<div class="card" data-card>
			{
				rows.map((row) => (
					<div class="row">
						<div class="row-head">
							<span class="piece">{row.piece}</span>
							<span class="budget">{row.budget}</span>
						</div>
						<div class="track">
							<div class="strip" style={`--seconds: ${row.seconds}s`}>
								{[0, 1].map(() =>
									row.cards.map((card) => (
										<div class="product">
											<div class:list={['photo', { picked: card.picked }]}>
												<Image src={card.image} alt="" width={180} loading="lazy" />
												{card.aiPick && (
													<span class="badge">
														<svg viewBox="0 0 16 16">
															<path d="M8 1.5c.5 3.6 2.9 6 6.5 6.5-3.6.5-6 2.9-6.5 6.5-.5-3.6-2.9-6-6.5-6.5 3.6-.5 6-2.9 6.5-6.5z" />
														</svg>
														AI pick
													</span>
												)}
												{card.picked && (
													<span class="check">
														<svg viewBox="0 0 16 16">
															<path d="M4.5 8.3l2.3 2.3 4.7-5" />
														</svg>
													</span>
												)}
											</div>
											<span class="shop">{card.shop}</span>
											<span class="price">{card.price}</span>
										</div>
									)),
								)}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</figure>

<script>
	// Pause the rows off screen, and draw the lines from the outline on the phone to the
	// card: from its right corners to the card's left ones when the card is beside the
	// phone, from its bottom corners to the card's top ones when it's below.
	for (const figure of document.querySelectorAll<HTMLElement>('[data-callout]')) {
		const stage = figure.querySelector<HTMLElement>('.stage')!;
		const zoom = figure.querySelector<HTMLElement>('[data-zoom]')!;
		const card = figure.querySelector<HTMLElement>('[data-card]')!;
		const svg = figure.querySelector<SVGSVGElement>('[data-lines]')!;
		const [a, b] = figure.querySelectorAll<SVGLineElement>('[data-line]');

		const set = (line: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			line.setAttribute('x1', String(x1));
			line.setAttribute('y1', String(y1));
			line.setAttribute('x2', String(x2));
			line.setAttribute('y2', String(y2));
		};

		const draw = () => {
			const s = stage.getBoundingClientRect();
			const z = zoom.getBoundingClientRect();
			const c = card.getBoundingClientRect();
			svg.setAttribute('viewBox', `0 0 ${s.width} ${s.height}`);
			const x = (v: number) => v - s.left;
			const y = (v: number) => v - s.top;
			if (c.left >= z.right) {
				set(a, x(z.right), y(z.top), x(c.left), y(c.top));
				set(b, x(z.right), y(z.bottom), x(c.left), y(c.bottom));
			} else {
				set(a, x(z.left), y(z.bottom), x(c.left), y(c.top));
				set(b, x(z.right), y(z.bottom), x(c.right), y(c.top));
			}
			figure.classList.add('has-lines');
		};

		new ResizeObserver(draw).observe(stage);
		new IntersectionObserver(([entry]) => {
			figure.classList.toggle('is-paused', !entry.isIntersecting);
		}).observe(figure);
	}
</script>

<style>
	.callout {
		container-type: inline-size;
		width: 100%;
		max-width: 30rem;
		margin: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.stage {
		position: relative;
		/* Narrow: the card's own size, from the figure's width. */
		--card: 30cqi;
	}

	.phone-wrap {
		position: relative;
		width: 64%;
		margin-inline: auto;
	}

	/* Steps.astro sizes every phone; this one is sized by the figure. */
	.stage :global(.phone) {
		max-width: none;
	}

	/* The phone's screen, inside its 0.5rem bezel, so the outline sits in screen percentages. */
	.screen-box {
		position: absolute;
		inset: 0.5rem;
		pointer-events: none;
	}

	/* Around the Top row in the screenshot: its title and the first two cards with their shops and prices. */
	.zoom {
		position: absolute;
		left: 2.5%;
		right: 21%;
		top: 38.6%;
		bottom: 31.4%;
		border: 1.5px solid var(--coral);
		border-radius: 0.5rem;
		box-shadow: 0 0 0 3px rgb(236 89 101 / 0.15);
	}

	.lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.3s;
	}

	.has-lines .lines {
		opacity: 1;
	}

	.lines line {
		stroke: var(--coral);
		stroke-width: 1.25;
		stroke-dasharray: 3 4;
	}

	/* Narrow: across the bottom of the phone, at full width. */
	.card {
		position: relative;
		display: grid;
		gap: 1rem;
		margin-top: -24%;
		padding: 1rem 0 1rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--bg);
		box-shadow: 0 1.25rem 2.5rem -1.5rem rgb(33 33 33 / 0.35);
		overflow: hidden;
	}

	.row {
		display: grid;
		gap: 0.5rem;
		min-width: 0;
	}

	.row-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-right: 1rem;
	}

	.piece {
		font-family: var(--font-display);
		font-size: 1.25rem;
		line-height: 1.1;
	}

	.budget {
		font-size: 0.75rem;
		color: var(--muted);
	}

	/* Soft edge where the cards slide out. */
	.track {
		overflow: hidden;
		mask-image: linear-gradient(to right, #000 82%, transparent);
	}

	.strip {
		display: flex;
		width: max-content;
	}

	/* Spaced with padding, not gap, so both halves of the strip are the same width. */
	.product {
		display: grid;
		gap: 0.0625rem;
		width: var(--card);
		padding-right: 0.625rem;
		box-sizing: content-box;
		font-size: 0.75rem;
		line-height: 1.3;
	}

	.photo {
		position: relative;
		aspect-ratio: 0.87;
		margin-bottom: 0.25rem;
		overflow: hidden;
		border-radius: var(--radius-small);
		background: var(--placeholder);
		box-shadow: 0 0 0 0.5px var(--line) inset;
	}

	.photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo.picked {
		box-shadow: 0 0 0 3px var(--text) inset;
	}

	.photo.picked img {
		/* Inside the 3px border, like the app's strokeBorder. */
		padding: 3px;
		border-radius: var(--radius-small);
	}

	.badge {
		position: absolute;
		top: 0.375rem;
		left: 0.375rem;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.125rem 0.4rem 0.125rem 0.3rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.92);
		color: #212121;
		font-size: 0.625rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.badge svg {
		width: 0.6rem;
		height: 0.6rem;
		fill: var(--coral);
	}

	.check {
		position: absolute;
		top: 0.375rem;
		right: 0.375rem;
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 999px;
		background: #212121;
		box-shadow: 0 0 0 1.5px #fff;
	}

	.check svg {
		width: 0.8rem;
		height: 0.8rem;
		fill: none;
		stroke: #fff;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.shop {
		overflow: hidden;
		color: var(--muted);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.price {
		font-weight: 700;
	}

	/* Wide enough: the card beside the phone, overlapping its right edge. */
	@container (inline-size >= 26rem) {
		.stage {
			--card: 5.75rem;
		}

		.phone-wrap {
			width: 56%;
			margin-inline: 0;
		}

		.card {
			position: absolute;
			left: 50%;
			right: 0;
			top: 31%;
			margin-top: 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.strip {
			animation: browse var(--seconds) linear infinite;
		}

		.is-paused .strip,
		.card:hover .strip {
			animation-play-state: paused;
		}
	}

	@keyframes browse {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-color-scheme: dark) {
		.card {
			box-shadow: 0 1.25rem 2.5rem -1.5rem rgb(0 0 0 / 0.6);
		}
	}
</style>
