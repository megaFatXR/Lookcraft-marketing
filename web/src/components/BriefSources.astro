---
// Step 1 of How it works, drawn instead of a screenshot: the kinds of things a brief can
// start from, each wired to the brief. The brief is drawn like the app's BriefComposer
// (StyleFit/Looks/BriefComposer.swift in the app repo): its title, the text field and its
// placeholders, reference thumbnails with their caption, Reference and Ideas, the budget
// per look and Style me. Keep the words in step with it.
//
// A small script lights up one source at a time and fills the brief from it, to say that
// any one of them is enough. Without the script, or with reduced motion, the first one
// stays lit. No brand logos: people take a screenshot, the app doesn't connect to
// Pinterest or Instagram, and their logos would suggest it did.

type Source = {
	icon: 'phone' | 'film' | 'words' | 'calendar' | 'photo';
	title: string;
	short: string;
	/** HTML, for the brand names in bold. */
	sub: string;
	/** A reference photo in the brief, drawn. */
	thumb?: 'screenshot' | 'movie' | 'photo';
	/** What's typed in the brief; without it the field shows the app's placeholder. */
	text?: string;
	/** The brief button that was used: Reference for a picture, Ideas for an occasion. */
	used?: 'reference' | 'ideas';
};

const sources: Source[] = [
	{ icon: 'phone', title: 'A screenshot', short: 'Screenshot', sub: 'From <strong>Pinterest</strong> or <strong>Instagram</strong>', thumb: 'screenshot', text: 'Same vibe, in navy', used: 'reference' },
	{ icon: 'film', title: 'A movie scene', short: 'Movie', sub: 'A character’s whole look', thumb: 'movie', text: 'His look in this scene', used: 'reference' },
	{ icon: 'words', title: 'A few words', short: 'Words', sub: 'Linen, relaxed, no tie', text: 'Linen, relaxed, no tie' },
	{ icon: 'calendar', title: 'An occasion', short: 'Occasion', sub: 'A summer wedding', text: 'A summer wedding', used: 'ideas' },
	{ icon: 'photo', title: 'A photo', short: 'Photo', sub: 'From your camera roll', thumb: 'photo', used: 'reference' },
];

// The app's placeholders: before and after a reference photo is added.
const placeholder = 'A vibe, an occasion, a reference…';
const referencePlaceholder = 'Anything to add? Optional, e.g. for a summer wedding';

// Wire ends, in the SVGs' stretched coordinates: from each source to a point on the brief.
const ends = [40, 45, 50, 55, 60];
---

<figure class="sources" data-sources>
	<figcaption class="visually-hidden">
		Start from a screenshot from Pinterest or Instagram, a scene from a movie, a few words,
		an occasion from the ideas or a photo from your camera roll, and set a budget per look.
	</figcaption>

	<div class="board" aria-hidden="true">
		<ul class="list">
			{
				sources.map((source, i) => (
					<li class:list={['source', { 'is-active': i === 0 }]} data-index={i}>
						<span class="pill">
							<span class="icon">
								{source.icon === 'phone' && (
									<svg viewBox="0 0 24 24">
										<rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
										<path d="M10.5 18.5h3" />
									</svg>
								)}
								{source.icon === 'film' && (
									<svg viewBox="0 0 24 24">
										<rect x="3" y="9" width="18" height="12" rx="1.5" />
										<path d="M3 9l16.5-4.5.8 3L3 12" />
										<path d="M8 7.6l2 3M13 6.2l2 3" />
									</svg>
								)}
								{source.icon === 'photo' && (
									<svg viewBox="0 0 24 24">
										<rect x="3" y="4" width="18" height="16" rx="2.5" />
										<circle cx="9" cy="9.5" r="1.75" />
										<path d="M3.5 17.5l5-5 4 4 2.5-2.5 5.5 5" />
									</svg>
								)}
								{source.icon === 'words' && (
									<svg viewBox="0 0 24 24">
										<path d="M4 18l4.5-12L13 18M5.7 13.5h5.6" />
										<path d="M19.5 18v-5.2a2.3 2.3 0 0 0-4.4-.9M19.5 15.4c-3.6 0-4.6.7-4.6 1.6 0 .7.6 1.2 1.6 1.2 1.6 0 3-1 3-2.8" />
									</svg>
								)}
								{source.icon === 'calendar' && (
									<svg viewBox="0 0 24 24">
										<rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
										<path d="M3.5 10h17M8.5 3v4M15.5 3v4" />
										<path d="M12 12.6l.9 1.9 2 .3-1.5 1.4.4 2-1.8-1-1.8 1 .4-2-1.5-1.4 2-.3z" />
									</svg>
								)}
							</span>
							<span class="label">
								<strong class="title">{source.title}</strong>
								<span class="short">{source.short}</span>
								<span class="sub" set:html={source.sub} />
							</span>
						</span>
					</li>
				))
			}
		</ul>

		<svg class="wires wires-across" viewBox="0 0 100 500" preserveAspectRatio="none">
			{
				ends.map((end, i) => (
					<path
						class:list={{ 'is-active': i === 0 }}
						data-index={i}
						d={`M0 ${50 + i * 100} C55 ${50 + i * 100}, 45 ${end * 5}, 100 ${end * 5}`}
						vector-effect="non-scaling-stroke"
					/>
				))
			}
		</svg>
		<svg class="wires wires-down" viewBox="0 0 500 100" preserveAspectRatio="none">
			{
				ends.map((end, i) => (
					<path
						class:list={{ 'is-active': i === 0 }}
						data-index={i}
						d={`M${50 + i * 100} 0 C${50 + i * 100} 55, ${end * 5} 45, ${end * 5} 100`}
						vector-effect="non-scaling-stroke"
					/>
				))
			}
		</svg>

		<div class="composer">
			<p class="prompt">What are we going for?</p>

			<!-- Every brief sits in the same cell, so the composer keeps the height of the tallest. -->
			<div class="briefs">
				{
					sources.map((source, i) => (
						<div
							class:list={['brief', { 'is-active': i === 0, typed: source.text && !source.thumb && !source.used }]}
							data-index={i}
						>
							<p class:list={['field', { empty: !source.text }]}>
								<span>{source.text ?? (source.thumb ? referencePlaceholder : placeholder)}</span>
							</p>
							{source.thumb && (
								<div class="references">
									<span class={`thumb thumb-${source.thumb}`}>
										<svg viewBox="0 0 24 32">
											<circle cx="12" cy="8" r="3.6" />
											<path d="M5 31l1.8-15.5Q12 12 17.2 15.5L19 31z" />
										</svg>
										<span class="remove" />
									</span>
									<span class="caption">The stylist builds the concept from this photo.</span>
								</div>
							)}
						</div>
					))
				}
			</div>

			<div class="chips">
				{
					sources.map((source, i) => (
						<span class="chip-state" data-index={i} data-used={source.used ?? ''} hidden={i !== 0} />
					))
				}
				<span class="chip is-on" data-chip="reference">
					<svg viewBox="0 0 24 24">
						<rect x="3" y="4" width="18" height="16" rx="2.5" />
						<circle cx="9" cy="9.5" r="1.75" />
						<path d="M3.5 17.5l5-5 4 4 2.5-2.5 5.5 5" />
					</svg>
					Reference
				</span>
				<span class="chip" data-chip="ideas">
					<svg viewBox="0 0 24 24">
						<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z" />
					</svg>
					Ideas
				</span>
			</div>

			<div class="budget">
				<div class="budget-row">
					<span>Budget per look</span>
					<strong>€300</strong>
				</div>
				<div class="slider">
					<span class="slider-end">€100</span>
					<span class="track"><span class="knob" /></span>
					<span class="slider-end">No limit</span>
				</div>
			</div>

			<span class="button">Style me</span>
		</div>
	</div>
</figure>

<script>
	// Light up the sources one at a time, only while the figure is on screen and the
	// visitor hasn't asked for reduced motion. Hovering a source shows that one.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

	for (const figure of document.querySelectorAll<HTMLElement>('[data-sources]')) {
		const sources = [...figure.querySelectorAll<HTMLElement>('.source')];
		const parts = [...figure.querySelectorAll<HTMLElement>('[data-index]')];
		const chips = [...figure.querySelectorAll<HTMLElement>('[data-chip]')];
		const used = sources.map((_, i) => figure.querySelector<HTMLElement>(`.chip-state[data-index="${i}"]`)?.dataset.used);
		let active = 0;
		let timer: number | undefined;
		let onScreen = false;
		let hovering = false;

		const show = (index: number) => {
			active = index;
			for (const part of parts) {
				part.classList.toggle('is-active', Number(part.dataset.index) === index);
			}
			for (const chip of chips) {
				chip.classList.toggle('is-on', chip.dataset.chip === used[index]);
			}
		};
		const stop = () => {
			clearInterval(timer);
			timer = undefined;
		};
		const start = () => {
			if (timer !== undefined || reduceMotion.matches || !onScreen || hovering || document.hidden) return;
			timer = window.setInterval(() => show((active + 1) % sources.length), 2800);
		};

		show(0);

		new IntersectionObserver(([entry]) => {
			onScreen = entry.isIntersecting;
			onScreen ? start() : stop();
		}, { threshold: 0.4 }).observe(figure);

		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		reduceMotion.addEventListener('change', () => {
			stop();
			show(0);
			start();
		});

		sources.forEach((source, index) => {
			source.addEventListener('pointerenter', () => {
				hovering = true;
				stop();
				show(index);
			});
			source.addEventListener('pointerleave', () => {
				hovering = false;
				start();
			});
		});
	}
</script>

<style>
	.sources {
		container-type: inline-size;
		width: 100%;
		margin: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Narrow: the sources in a row of bubbles, wired down into the brief. */
	.board {
		display: grid;
		grid-template-areas: 'list' 'wires' 'composer';
	}

	.list {
		grid-area: list;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}

	.pill {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
		text-align: center;
	}

	.icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		transition:
			background-color 0.4s,
			color 0.4s,
			border-color 0.4s;
	}

	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.icon svg {
		width: 1.375rem;
		height: 1.375rem;
	}

	.label {
		display: grid;
		line-height: 1.25;
	}

	.title,
	.sub {
		display: none;
	}

	.short {
		font-size: 0.8125rem;
		color: var(--muted);
		transition: color 0.4s;
	}

	.source.is-active .icon {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-text);
	}

	.source.is-active .short {
		color: var(--text);
	}

	.wires {
		overflow: visible;
	}

	.wires path {
		stroke: var(--line);
		stroke-width: 1.25;
		transition: stroke 0.4s;
	}

	.wires path.is-active {
		stroke: var(--coral);
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
	}

	.wires-across {
		display: none;
	}

	.wires-down {
		grid-area: wires;
		width: 100%;
		height: 3.25rem;
		padding-top: 0.5rem;
		margin-bottom: -1px;
	}

	/* The brief, drawn like the top of the app's Looks tab: on the app's page colour. */
	.composer {
		grid-area: composer;
		justify-self: center;
		display: grid;
		gap: 0.875rem;
		width: min(100%, 21rem);
		padding: 1.25rem 1.125rem 1.125rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--bg);
		box-shadow: 0 1.25rem 2.5rem -1.5rem rgb(33 33 33 / 0.35);
		container-type: inline-size;
	}

	.prompt {
		font-family: var(--font-display);
		/* On one line: smaller when the brief is narrow. */
		font-size: min(1.125rem, 100cqi / 12.8);
		line-height: 1.15;
		white-space: nowrap;
		letter-spacing: -0.01em;
	}

	.briefs {
		display: grid;
	}

	.brief {
		grid-area: 1 / 1;
		display: grid;
		align-content: start;
		gap: 0.75rem;
		opacity: 0;
		transform: translateY(0.25rem);
		transition:
			opacity 0.4s,
			transform 0.4s;
	}

	.brief.is-active {
		opacity: 1;
		transform: none;
	}

	.field {
		font-size: 0.9375rem;
		line-height: 1.4;
	}

	.field.empty {
		color: var(--muted);
	}

	/* Typed words get a caret. */
	.typed .field span::after {
		content: '';
		display: inline-block;
		width: 1.5px;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: currentColor;
	}

	.references {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.caption {
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--muted);
	}

	/* Like the app's 60×76 reference thumbnails, with their remove button. */
	.thumb {
		position: relative;
		display: grid;
		place-items: end center;
		flex: none;
		width: 3rem;
		height: 3.8rem;
		overflow: hidden;
		border-radius: var(--radius-small);
	}

	.thumb svg {
		width: 62%;
		fill: currentColor;
		stroke: none;
	}

	.remove {
		position: absolute;
		top: 3px;
		right: 3px;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 999px;
		background:
			linear-gradient(45deg, transparent 45%, #fff 45% 55%, transparent 55%) center / 55% 55% no-repeat,
			linear-gradient(-45deg, transparent 45%, #fff 45% 55%, transparent 55%) center / 55% 55% no-repeat,
			rgb(0 0 0 / 0.6);
	}

	.thumb-screenshot {
		background: var(--placeholder);
		color: var(--muted);
	}

	.thumb-movie {
		place-items: center;
		background: #2b2724;
		color: #8a8178;
		border-block: 0.55rem solid #0e0d0c;
	}

	.thumb-movie svg {
		width: auto;
		height: 100%;
	}

	.thumb-photo {
		background: #c9b8a3;
		color: #7d6a55;
	}

	.chips {
		display: flex;
		gap: 0.5rem;
	}

	.chip-state {
		display: none;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.8125rem;
		transition:
			background-color 0.4s,
			color 0.4s,
			border-color 0.4s;
	}

	.chip svg {
		width: 1rem;
		height: 1rem;
	}

	.chip.is-on {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-text);
	}

	.budget {
		display: grid;
		gap: 0.375rem;
	}

	.budget-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.budget-row strong {
		color: var(--text);
		font-weight: 600;
	}

	.slider {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.6875rem;
		color: var(--muted);
		white-space: nowrap;
	}

	/* The app's budget steps, with 300 the third of six. */
	.track {
		position: relative;
		flex: 1;
		height: 4px;
		border-radius: 999px;
		background: linear-gradient(to right, var(--text) 40%, var(--line) 40%);
	}

	.knob {
		position: absolute;
		top: 50%;
		left: 40%;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 999px;
		background: #fff;
		box-shadow:
			0 0 0 0.5px rgb(0 0 0 / 0.08),
			0 2px 6px rgb(0 0 0 / 0.2);
		transform: translate(-50%, -50%);
	}

	.button {
		display: grid;
		place-items: center;
		min-height: 2.75rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-text);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	/* Wide: the sources as pills in a column, wired across into the brief. */
	@container (inline-size >= 33rem) {
		.board {
			grid-template-areas: 'list wires composer';
			/* The wires take what's left after the pills and the brief, and the whole drawing
			   stays compact: 36rem at most, centred. */
			grid-template-columns: auto minmax(1.5rem, 1fr) minmax(14.5rem, 16.5rem);
			max-width: 36rem;
			margin-inline: auto;
			align-items: center;
			position: relative;
		}

		/* Stretched to the brief's height, in equal rows, so each pill sits where its wire
		   starts: at 10%, 30%, 50%, 70% and 90% of the height. */
		.list {
			grid-template-columns: none;
			grid-auto-rows: 1fr;
			align-self: stretch;
		}

		.source {
			display: flex;
			align-items: center;
			padding-block: 0.3125rem;
		}

		.pill {
			flex-direction: row;
			gap: 0.625rem;
			width: 100%;
			padding: 0.375rem 1rem 0.375rem 0.375rem;
			border: 1px solid var(--line);
			border-radius: 999px;
			background: var(--surface);
			text-align: start;
			transition: border-color 0.4s;
		}

		.icon {
			width: 2.375rem;
			height: 2.375rem;
			border: 0;
			background: var(--bg);
		}

		.icon svg {
			width: 1.25rem;
			height: 1.25rem;
		}

		.short {
			display: none;
		}

		.title,
		.sub {
			display: block;
		}

		.title {
			font-size: 0.9375rem;
			font-weight: 600;
		}

		.sub {
			font-size: 0.8125rem;
			color: var(--muted);
		}

		.sub :global(strong) {
			color: var(--text);
			font-weight: 600;
		}

		.source.is-active .pill {
			border-color: var(--text);
		}

		.wires-down {
			display: none;
		}

		/* Out of the flow, filling its column: the stretched viewBox would otherwise give
		   the SVG a tall shape of its own and push the row open. */
		.wires-across {
			display: block;
			grid-area: wires;
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
		}

		.composer {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.wires path.is-active {
			animation: flow 1.2s linear infinite;
		}

		.typed.is-active .field span::after {
			animation: blink 1s steps(1) infinite;
		}
	}

	@keyframes flow {
		to {
			stroke-dashoffset: -20;
		}
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
