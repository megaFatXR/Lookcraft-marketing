---
import { BRAND_NAME, TAGLINE } from '../consts';
import { withBase } from '../lib/url';
import AppStoreButton from './AppStoreButton.astro';
import Logo from './Logo.astro';
import PhoneFrame from './PhoneFrame.astro';
---

<header class="top container">
	<Logo />
	<nav aria-label="Page">
		<a href="#how-it-works">How it works</a>
		<a href="#faq">FAQ</a>
		<a href={withBase('support/')}>Support</a>
	</nav>
</header>

<section class="hero container" aria-labelledby="hero-title">
	<div class="copy">
		<p class="eyebrow">
			<svg viewBox="72 47 22 24" aria-hidden="true"><path d="M83 47Q85 56 94 59Q85 62 83 71Q81 62 72 59Q81 56 83 47Z" /></svg>
			{TAGLINE}
		</p>
		<h1 id="hero-title"><span>Love a look?</span> <span>Find&nbsp;it, try&nbsp;it, buy&nbsp;it.</span></h1>
		<p class="lede">
			Start from a picture: a screenshot from Pinterest or Instagram, a scene from a movie, a
			photo from your camera roll. Or just a few words. The stylist finds real pieces you can
			buy, in your budget and your country. Try the look on a photo of you, then shop it.
		</p>
		<div class="cta">
			<AppStoreButton />
			<p class="note">Free to style. For iPhone.</p>
		</div>
	</div>

	<div class="art">
		{/* Screen: a finished try-on on the look page, the shopper wearing a whole look. */}
		<PhoneFrame name="hero" alt={`A look tried on in ${BRAND_NAME}, on a photo of the shopper`} eager />
	</div>
</section>

<style>
	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.25rem;
	}

	nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	/* Phones keep the logo alone at the top, so it doesn't crowd. */
	@media (width < 30rem) {
		nav a:not(:last-child) {
			display: none;
		}
	}

	.hero {
		display: grid;
		gap: clamp(2.5rem, 8vw, 4rem);
		align-items: center;
		padding-block: clamp(2rem, 8vw, 5rem) clamp(3rem, 8vw, 5rem);
	}

	.copy {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}

	.eyebrow {
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--muted);
	}

	/* The logo's sparkle, in the app's coral. */
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.eyebrow svg {
		width: 0.875rem;
		height: 0.875rem;
		fill: var(--coral);
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.25rem);
	}

	/* One sentence per line wherever both fit. */
	h1 span {
		display: inline-block;
	}

	.lede {
		font-size: 1.125rem;
		color: var(--muted);
		max-width: 38ch;
	}

	.cta {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		margin-top: 0.75rem;
	}

	.note {
		font-size: 0.875rem;
		color: var(--muted);
	}

	.art {
		display: flex;
		justify-content: center;
	}

	.art :global(.phone) {
		max-width: min(17rem, 72vw);
	}

	@media (width >= 56rem) {
		.hero {
			grid-template-columns: 1.4fr 1fr;
		}

		.art :global(.phone) {
			max-width: 19rem;
		}
	}
</style>
