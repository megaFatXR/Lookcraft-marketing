---
import { BRAND_NAME, TAGLINE } from '../consts';
import { withBase } from '../lib/url';
import AppStoreButton from './AppStoreButton.astro';
import Logo from './Logo.astro';
import HeroTryOn from './HeroTryOn.astro';
---

<header class="top container">
	<Logo />
	<nav aria-label="Page">
		<a href="#how-it-works">How it works</a>
		<a href="#faq">FAQ</a>
		<a href={withBase('about/')}>About</a>
		<a href={withBase('support/')}>Support</a>
	</nav>
</header>

<section class="hero container" aria-labelledby="hero-title">
	<div class="head">
		<p class="eyebrow">
			<svg viewBox="72 47 22 24" aria-hidden="true"><path d="M83 47Q85 56 94 59Q85 62 83 71Q81 62 72 59Q81 56 83 47Z" /></svg>
			{TAGLINE}
		</p>
		<h1 id="hero-title">Level up your&nbsp;style.</h1>
	</div>

	<div class="body">
		<p class="lede">
			{BRAND_NAME} guides you to great looks made from real pieces you can buy, in your budget
			and your country. Start from a few words, three quick questions or a screenshot of a look you love.
		</p>
		<p class="try-on"><strong>Then see it on you.</strong> Try any look on a photo of yourself, and know it works before you&nbsp;buy.</p>
		<div class="cta">
			<AppStoreButton />
			<p class="note">Free to style. For iPhone.</p>
		</div>
	</div>

	<div class="art">
		{/* A plain photo wipes to its try-on, then the look's pieces float out around it. */}
		<HeroTryOn />
	</div>
</section>

<style>
	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.25rem;
	}

	nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	/* Phones keep the logo alone at the top, so it doesn't crowd. */
	@media (width < 30rem) {
		nav a:not(:last-child) {
			display: none;
		}
	}

	/* Phones: the headline, then the try-on right under it, so both show on the first
	   screen, then the rest of the copy and the button. */
	.hero {
		display: grid;
		grid-template-areas: 'head' 'art' 'body';
		gap: 1.75rem;
		padding-block: clamp(2rem, 8vw, 5rem) clamp(3rem, 8vw, 5rem);
	}

	.head {
		grid-area: head;
	}

	.body {
		grid-area: body;
	}

	.head,
	.body {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}

	.eyebrow {
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--muted);
	}

	/* The logo's sparkle, in the app's coral. */
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.eyebrow svg {
		width: 0.875rem;
		height: 0.875rem;
		fill: var(--coral);
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.25rem);
	}

	.lede {
		font-size: 1.125rem;
		color: var(--muted);
		max-width: 38ch;
	}

	/* The try-on is the point, so it reads louder than the lede. */
	.try-on {
		font-size: 1.1875rem;
		max-width: 36ch;
	}

	.try-on strong {
		font-weight: 700;
	}

	.cta {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		margin-top: 0.75rem;
	}

	.note {
		font-size: 0.875rem;
		color: var(--muted);
	}

	.art {
		grid-area: art;
		display: flex;
		justify-content: center;
	}

	/* Wide: the copy in one column, centred beside the try-on. */
	@media (width >= 56rem) {
		.hero {
			grid-template-areas: '. art' 'head art' 'body art' '. art';
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 1fr auto auto 1fr;
			gap: 1.25rem clamp(2.5rem, 8vw, 4rem);
		}

		/* 20% bigger than on phones, spilling a little into the gap and margin when the
		   column is narrower. */
		.art {
			align-self: center;
			--tryon-width: min(32.5rem, 100% + 3rem);
		}
	}

	/* Desktop: the try-on 15% bigger again, in a wider column that reaches into the side
	   margin. It's kept short enough to fit the first screen of a laptop (the drawing is
	   about 1.15 times as tall as it's wide). */
	@media (width >= 72rem) {
		.hero {
			grid-template-columns: 1fr 1.2fr;
		}

		.art {
			/* Up to 4rem into the margin, less where the window leaves less, so it never scrolls sideways. */
			margin-right: calc(-1 * min(4rem, (100vw - 64rem) / 2 - 1rem));
			--tryon-width: min(37.4rem, 100% + 5rem, (100svh - 11rem) / 1.15);
		}
	}
</style>
