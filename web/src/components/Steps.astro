---
import BriefSources from './BriefSources.astro';
import ConceptCallout from './ConceptCallout.astro';
import LookCallout from './LookCallout.astro';
import PhoneFrame from './PhoneFrame.astro';

// The app's own three steps (its How it works): a brief, the looks the shopper
// crafts from the stylist's concept, and try-ons.
// Bodies are HTML, for a few words in bold.
const steps = [
	{
		// Drawn, not a screenshot: what a brief can start from, wired into the brief box.
		slot: null,
		screen: '',
		title: 'Brief the stylist',
		body: 'Add a picture of a look you like, from Pinterest, Instagram, a movie or your camera roll. No picture? Describe it in a few words, or pick an occasion. Set a budget per look, from 100 to 700 or no limit.',
	},
	{
		// The phone shows the top of a real concept (step-concept), and a card zooms in on two of
		// its rows, sliding as if browsing: see ConceptCallout.astro.
		slot: 'step-concept',
		screen: '',
		callout: true,
		title: 'Craft your looks',
		body: 'The stylist puts together a concept from <strong>real pieces by brands you know</strong>, sold by shops in your country, in your currency. Pick a piece in each row. Every combination you create is saved as a look.',
	},
	{
		// The phone shows a finished try-on (step-try-on), and a card shows the look's pieces
		// to buy: see LookCallout.astro.
		slot: 'step-try-on',
		screen: '',
		look: true,
		title: 'Try it on',
		body: 'See the whole look on a photo of you. Love it? Each piece has a link to buy it from the shop.',
	},
];
---

<section id="how-it-works" class="steps container" aria-labelledby="steps-title">
	<h2 id="steps-title">How it works</h2>
	<ol>
		{
			steps.map(({ slot, screen, title, body, callout, look }, i) => (
				<li class:list={{ drawn: !slot, callout: callout || look }}>
					<div class="text">
						<span class="number" aria-hidden="true">
							{i + 1}
						</span>
						<h3>{title}</h3>
						<p set:html={body} />
					</div>
					{callout ? <ConceptCallout /> : look ? <LookCallout /> : slot ? <PhoneFrame name={slot} alt={screen} /> : <BriefSources />}
				</li>
			))
		}
	</ol>
</section>

<style>
	.steps {
		padding-block: clamp(3rem, 8vw, 5rem);
		border-top: 1px solid var(--line);
	}

	h2 {
		font-size: clamp(1.75rem, 5vw, 2.5rem);
	}

	ol {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: clamp(3rem, 8vw, 5rem);
	}

	li {
		display: grid;
		gap: 1.75rem;
		justify-items: center;
	}

	.text {
		display: grid;
		gap: 0.5rem;
		justify-self: stretch;
		max-width: 30rem;
	}

	.number {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-bottom: 0.25rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		font-family: var(--font-display);
		font-size: 1.125rem;
	}

	h3 {
		font-size: clamp(1.5rem, 4vw, 1.875rem);
	}

	p {
		color: var(--muted);
		font-size: 1.0625rem;
	}

	/* The body is HTML for this. */
	p :global(strong) {
		color: var(--text);
		font-weight: 600;
	}

	li :global(.phone) {
		max-width: min(13rem, 56vw);
	}

	/* Side by side on wide screens, the phone switching sides every step. */
	@media (width >= 48rem) {
		li {
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: clamp(2rem, 6vw, 5rem);
		}

		.text {
			justify-self: start;
		}

		li:nth-child(even) .text {
			order: 2;
		}

		li :global(.phone) {
			max-width: 16rem;
		}

		/* The drawing needs more room than a phone. */
		li.drawn {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
		}

		/* The phone and its zoomed-in rows. */
		li.callout {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}

		li.callout:nth-child(odd) {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		}
	}
</style>
