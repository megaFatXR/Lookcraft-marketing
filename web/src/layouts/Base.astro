---
import '../styles/global.css';
import { APP_RELEASED, APP_STORE_ID, BRAND_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../lib/url';

interface Props {
	title?: string;
	description?: string;
	/** Keep the page out of search results, as for the 404 page. */
	noindex?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(withBase('og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" href={withBase('favicon.ico')} sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href={withBase('icon-192.png')} sizes="192x192" />
		<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
		<link rel="sitemap" href={withBase('sitemap-index.xml')} />
		{/* Safari on iPhone shows a banner to open or get the app, once it's on the store. */}
		{APP_RELEASED && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={BRAND_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${BRAND_NAME} logo and name`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />

		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
